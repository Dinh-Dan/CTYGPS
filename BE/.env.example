# Sao chep file nay thanh .env va dien gia tri thuc
# .env KHONG duoc commit len git

# Server
PORT=5170
NODE_ENV=development

# Database (XAMPP MariaDB mac dinh)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gpsviet

# JWT
JWT_SECRET=doi-thanh-chuoi-bi-mat-dai-it-nhat-32-ky-tu
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=7d

# GoTrack API (server-to-server)
GOTRACK_BASE_URL=https://gps.gotrack.vn
GOTRACK_USERNAME=
GOTRACK_PASSWORD=

# ===== Backup database tu dong (tich hop trong backend) =====
# Bat/tat. De false neu chua muon chay.
BACKUP_ENABLED=false
# Backup moi bao nhieu gio mot lan
BACKUP_INTERVAL_HOURS=24
# (Tuy chon) Backup theo phut - neu dat > 0 se uu tien hon BACKUP_INTERVAL_HOURS
BACKUP_INTERVAL_MINUTES=0
# Giu lai bao nhieu ngay ban backup o local
BACKUP_KEEP_DAYS=14
# Chi giu lai N ban moi nhat (ca local lan Telegram). De 0 = dung theo so ngay.
BACKUP_KEEP_COUNT=0

# === Tren VPS Linux ===
# Thu muc luu backup
BACKUP_DIR=/var/db-backups
# Duong dan mysqldump (Ubuntu/Debian: /usr/bin/mysqldump | CentOS/RHEL: /usr/bin/mysqldump)
BACKUP_MYSQLDUMP=/usr/bin/mysqldump

# === Tren may local Windows (XAMPP) ===
# BACKUP_DIR=C:\db-backups
# BACKUP_MYSQLDUMP=C:\xampp\mysql\bin\mysqldump.exe

# Telegram Bot de gui backup ra ngoai VPS (de trong neu chi muon luu local)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
